{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "5.0",
    "noEmit": false,
    "outDir": "dist",
    "declaration": true,
    "rootDir": "src",
    "lib": ["es2022"],
    "target": "es2022"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
